{
  "format": "openengine",
  "version": 1,
  "dimension": "3D",
  "name": "Parcel Panic",
  "description": "A tiny workplace comedy on a floating island.",
  "controls": "WASD move · Space jump · Right drag look · E interact / kick · R respawn",
  "assets": {
    "football": {
      "SourceFile": "assets/football.svg",
      "mimeType": "image/svg+xml"
    }
  },
  "services": [
    {
      "id": "workspace",
      "className": "Folder",
      "name": "Workspace",
      "attributes": {},
      "children": [
        {
          "id": "island",
