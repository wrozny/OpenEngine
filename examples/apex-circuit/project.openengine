        {
          "id": "race-42",
          "className": "ServerScript",
          "name": "Recovery",
          "attributes": {},
          "children": [],
          "Source": "local run = game:GetService(\"RunService\")\nlocal nextAllowed = {}\nworkspace.Recover.OnServerEvent:Connect(function(player)\n if run.Time < (nextAllowed[player.UserId] or 0) then return end\n local car = player.Character\n if not car or car.Destroyed then return end\n nextAllowed[player.UserId] = run.Time + 5\n local index = math.max(1, (car:GetAttribute(\"Checkpoint\") or 1)-1)\n local gate = workspace.Checkpoints:FindFirstChild(tostring(index))\n car.Position = (car:GetAttribute(\"Checkpoint\") or 1) > 1 and gate.Position:Add(Vector3.new(0,2,0)) or Vector3.new(0,2,4)\n car.Rotation = Vector3.new()\n car.Velocity = Vector3.new()\nend)\ngame:GetService(\"Players\").PlayerRemoving:Connect(function(player) nextAllowed[player.UserId] = nil end)",
          "Enabled": true
        }
      ]
    },
