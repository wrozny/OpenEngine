    {
      "id": "scripts",
      "className": "Folder",
      "name": "ScriptService",
      "attributes": {},
      "children": [
        {
          "id": "city-folder-Templates",
          "className": "Folder",
          "name": "Templates",
          "attributes": {},
          "children": [
            {
              "id": "city-226",
              "className": "Object3D",
              "name": "Avatar",
              "attributes": {},
              "children": [
                {
                  "id": "city-controller",
                  "className": "PlayerController3D",
                  "name": "Movement",
                  "attributes": {},
                  "children": [],
                  "Source": "local actor = script.Parent\nassert(actor and actor:IsA(\"Object3D\"), \"PlayerController3D must be inside an Object3D\")\nlocal input = game:GetService(\"InputService\")\nlocal camera = game:GetService(\"Camera\")\nlocal run = game:GetService(\"RunService\")\nlocal physics = game:GetService(\"PhysicsService\")\nlocal free = script.Mode == \"FreeCamera\"\nactor.Anchored = free\nactor.Friction = 0\nactor.FixedRotation = true\nif free then actor.Sensor = true end\nif script.FollowCamera then camera.Follow = actor; camera.FirstPerson = free end\nlocal jumpWasDown = false\nrun.Heartbeat:Connect(function(dt)\n    if input:IsMouseDown(2) then\n        local delta = input:ConsumeMouseDelta()\n        camera.Yaw = camera.Yaw - delta.X * script.LookSensitivity\n        camera.Pitch = math.max(-1.35, math.min(1.35, camera.Pitch - delta.Y * script.LookSensitivity))\n    end\n    local x = input:GetAxis(script.LeftKey, script.RightKey)\n    local forward = input:GetAxis(script.BackKey, script.ForwardKey)\n    local yaw = camera.Yaw\n    local direction = Vector3.new(x * math.cos(yaw) - forward * math.sin(yaw), 0, -x * math.sin(yaw) - forward * math.cos(yaw))\n    if free then\n        local vertical = input:GetAxis(script.DownKey, script.JumpKey)\n        direction = direction:Add(Vector3.new(0, vertical + forward * math.sin(camera.Pitch), 0))\n        actor.Position = actor.Position:Add(direction.Unit:Mul(script.FlySpeed * dt))\n        actor.Velocity = Vector3.new()\n    else\n        local vy = actor.Velocity.Y\n        local jump = input:IsKeyDown(script.JumpKey)\n        local probe = physics:GetGround(actor, script.MaxSlopeAngle)\n        if jump and not jumpWasDown and probe and probe.Normal.Y > 0.5 and vy < 1 then vy = script.JumpSpeed end\n        local walk = direction.Unit:Mul(script.Speed)\n        physics:MoveCharacter(actor, Vector3.new(walk.X, vy, walk.Z), dt, script.StepHeight, script.MaxSlopeAngle)\n        jumpWasDown = jump\n    end\nend)\n",
                  "Enabled": true,
                  "Mode": "Platformer",
                  "Speed": 7,
                  "JumpSpeed": 9,
                  "StepHeight": 0.45,
                  "MaxSlopeAngle": 50,
                  "FlySpeed": 12,
                  "LookSensitivity": 0.003,
                  "FollowCamera": true,
                  "LeftKey": "a",
                  "RightKey": "d",
                  "ForwardKey": "w",
                  "BackKey": "s",
                  "JumpKey": " ",
                  "DownKey": "control"
                }
              ],
              "Texture": "",
              "Shape": "Box",
              "Color": "#62b6f2",
              "Size": {
                "X": 0.85,
                "Y": 1.9,
                "Z": 0.85
              },
              "Anchored": false,
              "Sensor": false,
              "Visible": true,
              "CollisionGroup": "player",
              "Restitution": 0.1,
              "Friction": 0,
              "Mass": 1,
              "FixedRotation": true,
              "Material": "Default",
              "TextureScale": 1,
              "Position": {
                "X": 0,
                "Y": 2,
                "Z": 0
              },
              "Rotation": {
                "X": 0,
                "Y": 0,
                "Z": 0
              }
            }
          ]
